# Copy this file to .env and paste your own keys in.
# NEVER commit .env - it is listed in .gitignore for a reason.
# Close this file once you have saved it. A key on screen is a key shared.

# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-key-here

# BOTH keys, please. Free tiers refuse service without warning, and when one
# does you switch to the other and keep working instead of losing the lab.
# Get one free at https://console.mistral.ai
MISTRAL_API_KEY=paste-your-key-here
